#!/usr/bin/env bash
# deploy: copy device/ onto the Presto over USB, then restart it.
#
#   tools/deploy [PORT]        (default /dev/ttyACM0)
#
# Needs mpremote (pip install mpremote). Close Thonny first: only one program
# can hold the port. Uses a plain `mpremote connect` (it soft-resets first, so
# no app holds the screen or SD card; `resume` against a running app has
# stalled the USB serial before). Never touches secrets.py or /examples.
# Day to day the Presto updates itself over Wi-Fi (device/lib/neon/ota.py,
# presto#9); this is for main.py and ota_boot.py, which only change here, and
# for when Wi-Fi updates can't help.
set -euo pipefail

port=${1:-/dev/ttyACM0}
here=$(cd "$(dirname "$0")/.." && pwd)
dev="$here/device"
mpr=${MPREMOTE:-mpremote}

if command -v fuser >/dev/null && fuser "$port" >/dev/null 2>&1; then
    echo "deploy: $port is in use (Thonny?). Disconnect it first." >&2
    exit 1
fi

args=(exec "import os
for p in ('/lib', '/lib/neon'):
    try: os.mkdir(p)
    except OSError: pass")
while IFS= read -r f; do
    rel=${f#"$dev"/}
    args+=(+ cp "$f" ":/$rel")
done < <(find "$dev" -type f \( -name '*.py' -o -name '*.yaml' \) | sort)

# Record the version this installs, as a Wi-Fi update would (presto#9): the
# Presto then doesn't fetch the same files again, and a USB deploy ends any
# update on trial (and its backups).
version=$(python3 "$here/presto_photos/device.py" "$dev" | python3 -c 'import json, sys; print(json.load(sys.stdin)["version"])')
args+=(+ exec "import ota_boot
ota_boot.remove_tree('/ota/prev')
ota_boot.remove_tree('/ota/new')
ota_boot.write({'version': '$version', 'status': 'ok'})")

"$mpr" connect "$port" "${args[@]}"
echo "deploy: copied $version; restarting"
# Leave Wi-Fi cleanly first: reset while still joined, and the router turns the
# next boot's join away for a while (status -1; 4-8 of 8 boots, against 0 of 8
# after a disconnect, 2026-11-04, presto#18).
"$mpr" connect "$port" exec "import network, time, machine
w = network.WLAN(network.STA_IF)
w.disconnect()
time.sleep(2)
w.active(False)
time.sleep(1)
machine.reset()" >/dev/null 2>&1 || true
